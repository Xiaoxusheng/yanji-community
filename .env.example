# ============================================================
# 综合社区论坛平台 - 环境变量样例
# 复制为 .env 后按需修改。真实凭据严禁提交仓库。
# ============================================================

# ---- 运行环境 ----
APP_ENV=development            # development | production
APP_PORT=8080                  # Go API 监听端口
APP_PUBLIC_URL=http://localhost:3000
REQUEST_ID_HEADER=X-Request-Id

# ---- PostgreSQL ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=yanji
POSTGRES_PASSWORD=yanji_dev_password      # 生产环境必须更换
POSTGRES_DB=yanji_community
DATABASE_URL=postgres://yanji:yanji_dev_password@127.0.0.1:5432/yanji_community?sslmode=disable
DATABASE_MAX_CONNS=20

# ---- Redis ----
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 认证与会话 ----
SESSION_TTL_HOURS=168                      # 会话有效期（小时），默认 7 天
COOKIE_DOMAIN=                             # 留空表示仅当前 host
COOKIE_SECURE=false                        # 生产环境必须为 true（HTTPS）
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@2024             # 首次启动生成管理员，生产环境必须更换并删除

# ---- 文件上传 ----
STORAGE_DRIVER=local                       # local | s3
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_PUBLIC_BASE=/files
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
UPLOAD_MAX_BYTES=10485760                  # 10MB

# ---- 邮件（开发环境默认写日志，不真实发送）----
MAIL_DRIVER=log                            # log | smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# ---- 限流（每分钟请求数）----
RATE_LIMIT_AUTH=20                         # 登录/注册/重置密码
RATE_LIMIT_WRITE=60                        # 发帖/评论/互动
RATE_LIMIT_READ=300                        # 浏览/搜索

# ---- 前端 ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
